# Copy to .env and fill in. Everything has a safe default for local testing.

PORT=3000
# Listen on this machine only; nginx in front is the way in. 1 = trust nginx/Cloudflare for the visitor's address.
HOST=127.0.0.1
TRUST_PROXY=0
# The public address of the site, used in email links and Stripe's return pages.
BASE_URL=http://localhost:3000
NODE_ENV=development

BUSINESS_NAME=Augustines.Visn
# Where new-booking notices go, and where client replies land.
ADMIN_EMAIL=

# Admin login. Required in production.
ADMIN_PASSWORD=
# Signs the admin login cookie. Without it, a new one is made at each start (everyone is logged out on restart).
SESSION_SECRET=

# Where sessions happen. Golden-hour times are worked out from this spot. Default: Phoenix, AZ.
LATITUDE=33.4484
LONGITUDE=-112.0740
TIMEZONE=America/Phoenix

# Stripe (test keys while building). Without a key, development mode uses a fake "paid" button instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email. Without a key, emails are printed to the console instead of sent.
RESEND_API_KEY=
MAIL_FROM=

# Database file. Uploaded photos go in data/media (public) and data/galleries (private).
DB_FILE=./data/booking.sqlite
# Makes web-size copies of uploaded photos when installed (recommended: sudo apt install ffmpeg). 'none' = off.
FFMPEG_PATH=ffmpeg
